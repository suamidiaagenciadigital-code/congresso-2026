{
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/admin/campanhas",
      "schedule": "0 11 * * *"
    }
  ]
}
